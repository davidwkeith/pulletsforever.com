    "new-post": "tsx scripts/new-post.ts",
    "webmentions:send": "tsx scripts/send-webmentions.ts",
    "webmentions:send:dry": "tsx scripts/send-webmentions.ts --dry-run",
    "websub:ping": "tsx scripts/ping-websub.ts",
    "websub:ping:dry": "tsx scripts/ping-websub.ts --dry-run",
    "predeploy": "tsx scripts/pre-deploy-check.ts",
    "deploy": "npm run build && npm run predeploy && wrangler deploy && npm run websub:ping && npm run webmentions:send",
    "deploy:preview": "npm run build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types"
  },
