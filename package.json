    "tsx": "^4.19.0",
    "@cloudflare/workers-types": "^4.20260218.0",
    "@types/jsdom": "^27.0.0",
    "dotenv": "^17.3.1",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.66.0"
  },
