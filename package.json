  "type": "module",
  "scripts": {
    "build": "astro build",
    "start": "astro dev",
    "dev": "astro dev",
    "preview": "astro preview",
    "test": "npm test --prefix worker",
    "typecheck": "astro check",
    "new-post": "tsx scripts/new-post.ts",
    "webmentions:send": "tsx scripts/send-webmentions.ts",
    "webmentions:send:dry": "tsx scripts/send-webmentions.ts --dry-run",
    "websub:ping": "tsx scripts/ping-websub.ts",
    "websub:ping:dry": "tsx scripts/ping-websub.ts --dry-run",
    "scan": "tsx scripts/pre-deploy-check.ts",
    "deploy": "npm run build && npm run scan && wrangler deploy && npm run websub:ping && npm run webmentions:send",
    "deploy:preview": "npm run build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint:md": "markdownlint-cli2 'docs/**/*.md' '*.md'"
  },
  "author": {
    "name": "David W. Keith",
    "email": "git@dwk.io",
    "url": "https://dwk.io/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davidwkeith/pulletsforever.com.git"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "markdownlint-cli2": "^0.22.0",
    "stylelint": "^17.6.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "schema-dts": "^2.0.0",
    "tsx": "^4.19.0",
    "@cloudflare/workers-types": "^4.20260218.0",
    "@types/jsdom": "^27.0.0",
    "dotenv": "^17.3.1",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.102.0"
  },
  "dependencies": {
    "@astrojs/markdoc": "^1.0.6",
    "@astrojs/react": "5.0.4",
    "@astrojs/sitemap": "^3.7.1",
    "@keystatic/astro": "5.1.0",
    "@keystatic/core": "0.5.50",
    "@markdoc/markdoc": "^0.5.0",
    "astro": "^6.4.8",
    "markdown-it-footnote": "^4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "devalue": "^5.8.1",
    "esbuild": "^0.25.0",
    "js-yaml": "^4.2.0"
  }
