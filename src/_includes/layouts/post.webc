---
layout: layouts/base.njk
---
<link rel="stylesheet" href="/css/prism-light.css" media="(prefers-color-scheme: light)" webc:keep>
<link rel="stylesheet" href="/css/prism-dark.css" media="(prefers-color-scheme: dark)" webc:keep>
<link rel="stylesheet" href="../css/prism-diff.css">
<slider-assets></slider-assets>
<script webc:type="js">
export default function() {
const { $data, filterTagList, slugify, relatedPosts, firstImage, socialImageUrl, htmlDateString, readableDate, readingTime } = this;
const esc = (s) => s ? s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;') : '';
const meta = $data.metadata;
const page = $data.page;
const rawContent = $data.content || '';
const footnoteMarker = '<section class="footnotes">';
const fnIndex = rawContent.indexOf(footnoteMarker);
let postBody, postFootnotes;
if (fnIndex > -1) {
  postBody = rawContent.slice(0, fnIndex);
  postFootnotes = rawContent.slice(fnIndex);
} else {
  postBody = rawContent;
  postFootnotes = '';
}
const postContent = rawContent;
const postTitle = $data.title || '';
const postTags = filterTagList($data.tags || []);
const postHero = $data.hero;
const collections = $data.collections || {};

// Tag list items
const tagItems = postTags.map((tag, i) => {
  const tagUrl = `/tags/${slugify(tag)}/`;
  const comma = i < postTags.length - 1 ? ', ' : '';
  return `<li><a href="${tagUrl}" class="post-tag p-category" aria-label="Posts tagged ${esc(tag)}">${esc(tag)}</a>${comma}</li>`;
}).join('\n\t');

// Hero image
let heroHtml = '';
if (postHero) {
  const heroSrc = page.filePathStem + '/' + postHero.src;
  const captionHtml = postHero.caption ? `\n      <figcaption>${esc(postHero.caption)}</figcaption>` : '';
  heroHtml = `
    <figure class="hero-image">
      ${heroSrc}${captionHtml}
    </figure>`;
}

// Related posts
const relatedList = relatedPosts($data.tags || [], page.url, collections.posts || []);
let relatedHtml = '';
if (relatedList.length > 0) {
  const relatedItems = relatedList.map(post => {
    const pTitle = (post.data && post.data.title) || post.url;
    const pImage = firstImage(post.templateContent || '');
    const pSocialImage = socialImageUrl(pTitle, pImage, post.inputPath);
    return `\t\t<li class="related-post-tile">
\t\t\t<a href="${post.url}" class="related-post-tile-link">
\t\t\t\t<img class="related-post-tile-image" src="${esc(pSocialImage)}" alt="" loading="lazy" eleventy:ignore>
\t\t\t\t<span class="related-post-tile-title">${esc(pTitle)}</span>
\t\t\t</a>
\t\t</li>`;
  }).join('\n');
  relatedHtml = `
<aside class="related-posts" aria-labelledby="related-heading">
\t<h3 id="related-heading">Related Posts</h3>
\t<ul class="related-post-grid">
${relatedItems}
\t</ul>
</aside>`;
}

return `<div class="h-entry">
<h2 class="p-name">${esc(postTitle)}</h2>

<ul class="post-metadata">
\t<li><time class="dt-published" datetime="${htmlDateString(page.date)}">${readableDate(page.date)}</time></li>
\t<li>${readingTime(postContent)}</li>
\t${tagItems}
</ul>
<a class="u-url" href="${page.url}" aria-hidden="true" tabindex="-1"></a>
<a class="p-author h-card" href="https://dwk.io">${esc(meta.author.name)}</a>
<article class="e-content">${heroHtml}
  ${postBody}
  <p class="signature">-dwk</p>
  ${postFootnotes ? '<hr class="footnotes-sep">' + postFootnotes : ''}
</article>
</div>
${relatedHtml}`;
}
</script>
<web-mentions :webmentions="$data.webmentions" :page-url="$data.page.url" :site-url="$data.metadata.url"></web-mentions>
<script webc:type="js">
export default function() {
const { $data, getPreviousCollectionItem, getNextCollectionItem } = this;
const esc2 = (s) => s ? s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;') : '';
const collections2 = $data.collections || {};
const page2 = $data.page;

let prevNextHtml = '';
if (collections2.posts) {
  const previousPost = getPreviousCollectionItem(collections2.posts, page2);
  const nextPost = getNextCollectionItem(collections2.posts, page2);
  if (previousPost || nextPost) {
    let navItems = '';
    if (previousPost) {
      navItems += `<li>Previous: <a href="${previousPost.url}">${esc2(previousPost.data.title)}</a></li>`;
    }
    if (nextPost) {
      navItems += `<li>Next: <a href="${nextPost.url}">${esc2(nextPost.data.title)}</a></li>`;
    }
    prevNextHtml = `
<nav aria-label="Post navigation">
<ul class="links-nextprev">
\t${navItems}
</ul>
</nav>`;
  }
}
return prevNextHtml;
}
</script>
<script webc:keep>
// Footnote popups — shows footnote content on hover (MediaWiki-style)
(function () {
  const refs = document.querySelectorAll(".footnote-ref a[href^='#footnote']");
  if (!refs.length) return;

  let popup = null;
  let hideTimer = null;

  function createPopup() {
    popup = document.createElement("div");
    popup.className = "footnote-popup";
    popup.setAttribute("role", "tooltip");
    document.body.appendChild(popup);
    popup.addEventListener("mouseenter", () => clearTimeout(hideTimer));
    popup.addEventListener("mouseleave", scheduleHide);
  }

  function scheduleHide() {
    hideTimer = setTimeout(() => {
      if (popup) popup.classList.remove("visible");
    }, 200);
  }

  function show(ref) {
    clearTimeout(hideTimer);
    const id = ref.getAttribute("href").slice(1);
    const note = document.getElementById(id);
    if (!note) return;
    if (!popup) createPopup();
    popup.innerHTML = note.innerHTML;
    popup.classList.add("visible");

    const rect = ref.getBoundingClientRect();
    const popupWidth = Math.min(360, window.innerWidth - 20);
    popup.style.width = popupWidth + "px";

    // Position popup below the ref, arrow pointing at ref center
    const refCenter = rect.left + window.scrollX + rect.width / 2;
    let left = refCenter - 20;
    if (left + popupWidth > window.innerWidth - 10) {
      left = window.innerWidth - popupWidth - 10;
    }
    if (left < 10) left = 10;

    popup.style.left = left + "px";
    popup.style.top = (rect.bottom + window.scrollY + 5) + "px";

    // Arrow is 12px wide (6px border), offset by 6 to center on refCenter
    const arrowLeft = Math.max(6, Math.min(refCenter - left - 6, popupWidth - 18));
    popup.style.setProperty("--arrow-left", arrowLeft + "px");
  }

  refs.forEach((ref) => {
    ref.addEventListener("mouseenter", () => show(ref));
    ref.addEventListener("mouseleave", scheduleHide);
    ref.addEventListener("focus", () => show(ref));
    ref.addEventListener("blur", scheduleHide);
  });
})();
</script>
