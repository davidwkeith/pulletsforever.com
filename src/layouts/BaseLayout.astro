---
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";
import siteConfig from "../site.config.ts";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = siteConfig.description,
  image,
  jsonLd,
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL(siteConfig.url));
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const ogImage = image
  ? new URL(image, siteOrigin).toString()
  : new URL(siteConfig.logo.src, siteOrigin).toString();

const SEO_TITLE_MAX = 60;
const brandSuffix = ` — ${siteConfig.title}`;
const fullTitle =
  Astro.url.pathname === "/"
    ? siteConfig.title
    : title.length + brandSuffix.length > SEO_TITLE_MAX
      ? title
      : `${title}${brandSuffix}`;

const { version } = JSON.parse(
  readFileSync(resolve(process.cwd(), "package.json"), "utf-8"),
);
const configPath = resolve(process.cwd(), ".site-config");
const configContent = existsSync(configPath)
  ? readFileSync(configPath, "utf-8")
  : "";
const aiModel =
  configContent.match(/^AI_MODEL=(.+)$/m)?.[1]?.trim() ?? "Claude";
const generator = `Anglesite ${version} (${aiModel}, ${Astro.generator})`;

const websiteJsonLd = jsonLd ?? siteConfig.schema;
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content={siteConfig.colorScheme} />
    <meta name="generator" content={generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author.name} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={siteConfig.favicon} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:type" content={siteConfig.ogType} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {siteConfig.headLinks.map((link) => (
      <link
        rel={link.rel}
        href={link.href}
        type={link.type}
        title={link.title}
      />
    ))}

    {websiteJsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(websiteJsonLd)}
      />
    )}

  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="h-card">
      <a href="/" class="header-logo">
        <img src={siteConfig.logo.src} alt={siteConfig.logo.alt} width="64" height="64" />
      </a>
      <div class="header-title">
        {Astro.url.pathname === "/" ? (
          <h1 class="p-name">{siteConfig.title}</h1>
        ) : (
          <a href="/" class="p-name u-url">{siteConfig.title}</a>
        )}
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      {!isHome && (
        <ul class="footer-social" role="list">
        <li>
          <a href={siteConfig.author.alternates.mastodon} rel="me external">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.327 8.566c0-4.339-2.843-5.61-2.843-5.61-1.433-.658-3.894-.935-6.451-.956h-.063c-2.557.021-5.016.298-6.45.956 0 0-2.843 1.271-2.843 5.61 0 .993-.019 2.181.012 3.441.103 4.243.778 8.425 4.701 9.463 1.809.479 3.362.579 4.612.51 2.268-.126 3.541-.809 3.541-.809l-.075-1.646s-1.621.511-3.441.449c-1.804-.062-3.707-.194-3.999-2.409a4.523 4.523 0 0 1-.04-.621s1.77.432 4.014.535c1.372.063 2.658-.08 3.965-.236 2.506-.299 4.688-1.843 4.962-3.254.432-2.223.396-5.424.396-5.424zm-3.353 5.59h-2.081V9.057c0-1.075-.452-1.62-1.357-1.62-1 0-1.501.647-1.501 1.927v2.791h-2.069V9.364c0-1.28-.501-1.927-1.502-1.927-.904 0-1.357.545-1.357 1.62v5.099H6.026V8.903c0-1.074.273-1.927.823-2.558.566-.631 1.307-.955 2.228-.955 1.065 0 1.872.41 2.405 1.228l.518.869.519-.869c.533-.818 1.34-1.228 2.405-1.228.92 0 1.662.324 2.228.955.549.631.822 1.484.822 2.558v5.253z"/></svg>
            <span>Mastodon</span>
          </a>
        </li>
        <li>
          <a href={siteConfig.author.alternates.keybase} rel="me external">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10.446 21.371c0 .528-.428.957-.957.957s-.957-.43-.957-.957.428-.957.957-.957.957.43.957.957zm6.024-.096a.903.903 0 0 1-.903.903.903.903 0 0 1-.903-.903.903.903 0 0 1 .903-.903.903.903 0 0 1 .903.903zM20.742 4.09c0-.47-.38-.851-.851-.851s-.851.381-.851.851.38.851.851.851.851-.381.851-.851zm2.03 1.474a2.083 2.083 0 0 1-2.083 2.083 2.083 2.083 0 0 1-2.083-2.083 2.083 2.083 0 0 1 2.083-2.083 2.083 2.083 0 0 1 2.083 2.083zM8.876 2.474c0-.904-.733-1.636-1.637-1.636-.904 0-1.636.732-1.636 1.636s.732 1.636 1.636 1.636c.904 0 1.637-.732 1.637-1.636zM20.612 8.258a4.292 4.292 0 0 0-2.136-1.478l1.567-1.566a2.92 2.92 0 0 0 .861-2.078 2.923 2.923 0 0 0-2.922-2.923 2.92 2.92 0 0 0-2.078.861l-1.565 1.567a4.302 4.302 0 0 0-1.478-2.137A4.297 4.297 0 0 0 10.178 0a4.302 4.302 0 0 0-2.731 4.005v2.074L4.59 2.862A2.795 2.795 0 0 0 2.6 2.03a2.8 2.8 0 0 0-1.988.822A2.803 2.803 0 0 0 .61 6.667l4.123 5.247a4.29 4.29 0 0 0-.485 1.575l-.188 1.662a4.293 4.293 0 0 0 1.108 3.349c.014.014.028.024.042.038l3.396 3.4a3.475 3.475 0 0 0-.01.225c0 1.932 1.571 3.503 3.503 3.503 1.932 0 3.503-1.571 3.503-3.503a3.476 3.476 0 0 0-.085-.744 3.53 3.53 0 0 0 1.755-.703 3.422 3.422 0 0 0 1.234-1.904 3.422 3.422 0 0 0-.104-2.238l1.455-1.455 1.656-.189a4.303 4.303 0 0 0 1.575-.485l5.247 4.123a2.8 2.8 0 0 0 3.815-.002 2.802 2.802 0 0 0-.002-3.978l-3.217-2.857h2.074A4.302 4.302 0 0 0 24 10.178a4.291 4.291 0 0 0-.504-2.683 4.291 4.291 0 0 0-2.884-1.237z"/></svg>
            <span>Keybase</span>
          </a>
        </li>
        <li>
          <a href={siteConfig.author.alternates.facebook} rel="me external">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            <span>Facebook</span>
          </a>
        </li>
        <li>
          <a href={siteConfig.author.alternates.reddit} rel="me external">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg>
            <span>Reddit</span>
          </a>
        </li>
        <li>
          <a href={siteConfig.author.alternates.github} rel="me external">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            <span>GitHub</span>
          </a>
        </li>
        <li>
          <a href={siteConfig.author.alternates.linkedin} rel="me external">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            <span>LinkedIn</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${siteConfig.email}`} rel="me">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67z"/><path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908z"/></svg>
            <span>Email</span>
          </a>
        </li>
        </ul>
      )}
      <p class="footer-license">
        <a property="dct:title" rel="cc:attributionURL" href={siteConfig.url}>{siteConfig.title}</a>
        {" by "}
        <a rel="cc:attributionURL dct:creator author me" property="cc:attributionName" href={siteConfig.author.url}>{siteConfig.author.name}</a>
        {" is licensed under"}
        <br />
        <a href="https://creativecommons.org/licenses/by/4.0/?ref=chooser-v1" target="_blank" rel="license noopener noreferrer">Creative Commons Attribution 4.0 International<img class="footer-cc-icon" src="https://mirrors.creativecommons.org/presskit/icons/cc.svg" alt="" width="22" height="22" loading="lazy" decoding="async" /><img class="footer-cc-icon" src="https://mirrors.creativecommons.org/presskit/icons/by.svg" alt="" width="22" height="22" loading="lazy" decoding="async" /></a>
      </p>
      <a class="footer-greenweb" href={`https://www.thegreenwebfoundation.org/green-web-check/?url=${siteConfig.site}`} target="_blank" rel="noopener noreferrer">
        <img
          src={`https://app.greenweb.org/api/v3/greencheckimage/${siteConfig.site}`}
          width="200"
          height="95"
          alt={`This website runs on green hosting - verified by thegreenwebfoundation.org`}
          loading="lazy"
          decoding="async"
        />
      </a>
    </footer>

    <script is:inline src="/js/footnote-popup.js" defer></script>
  </body>
</html>
