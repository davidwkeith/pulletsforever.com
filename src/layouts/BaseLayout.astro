---
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";
import siteConfig from "../site.config.ts";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = siteConfig.description,
  image,
  jsonLd,
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL(siteConfig.url));
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const ogImage = image
  ? new URL(image, siteOrigin).toString()
  : new URL(siteConfig.logo.src, siteOrigin).toString();

const fullTitle =
  Astro.url.pathname === "/" ? siteConfig.title : `${title} — ${siteConfig.title}`;

const { version } = JSON.parse(
  readFileSync(resolve(process.cwd(), "package.json"), "utf-8"),
);
const configPath = resolve(process.cwd(), ".site-config");
const configContent = existsSync(configPath)
  ? readFileSync(configPath, "utf-8")
  : "";
const aiModel =
  configContent.match(/^AI_MODEL=(.+)$/m)?.[1]?.trim() ?? "Claude";
const generator = `Anglesite ${version} (${aiModel}, ${Astro.generator})`;

const websiteJsonLd = jsonLd ?? siteConfig.schema;
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content={siteConfig.colorScheme} />
    <meta name="generator" content={generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author.name} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={siteConfig.favicon} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:type" content={siteConfig.ogType} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {siteConfig.headLinks.map((link) => (
      <link
        rel={link.rel}
        href={link.href}
        type={link.type}
        title={link.title}
      />
    ))}

    {websiteJsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(websiteJsonLd)}
      />
    )}

  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="h-card">
      <a href="/" class="header-logo">
        <img src={siteConfig.logo.src} alt={siteConfig.logo.alt} width="64" height="64" />
      </a>
      <div class="header-title">
        {Astro.url.pathname === "/" ? (
          <h1 class="p-name">{siteConfig.title}</h1>
        ) : (
          <a href="/" class="p-name u-url">{siteConfig.title}</a>
        )}
      </div>
      <nav aria-label="Main">
        <a href="/blog/">Blog</a>
        <a href="/tags/">Tags</a>
        <a href="/feed.xml" rel="alternate" type="application/atom+xml">Feed</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <ul class="footer-social">
        <li>
          <a href={siteConfig.author.alternates.mastodon} rel="me">Mastodon</a>
        </li>
        <li>
          <a href={siteConfig.author.alternates.github} rel="me">GitHub</a>
        </li>
        <li>
          <a href={siteConfig.author.alternates.linkedin} rel="me">LinkedIn</a>
        </li>
        <li>
          <a href={siteConfig.author.alternates.keybase} rel="me">Keybase</a>
        </li>
      </ul>
      <p>
        © {new Date().getFullYear()}
        <a class="u-url" href={siteConfig.author.url} rel="author">
          {siteConfig.author.name}
        </a>
        {" · "}
        <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">
          CC BY 4.0
        </a>
      </p>
    </footer>
  </body>
</html>
