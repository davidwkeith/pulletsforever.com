---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { publishedPosts } from "../../utils/feed.ts";

const all = await getCollection("posts", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});
const posts = publishedPosts(all);

const monthYear = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
});
---

<BaseLayout title="Blog" description="All posts.">
  <h1>Blog</h1>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li class="h-entry">
          <a href={`/${post.id}/`} class="u-url">
            <h2 class="p-name">{post.data.title}</h2>
          </a>
          <time
            class="dt-published"
            datetime={post.data.publishDate.toISOString()}
          >
            {monthYear.format(post.data.publishDate)}
          </time>
          {post.data.description && (
            <p class="p-summary">{post.data.description}</p>
          )}
        </li>
      ))
    }
  </ul>
</BaseLayout>
