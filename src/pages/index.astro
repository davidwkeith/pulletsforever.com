---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import { getCollection } from "astro:content";
import { publishedPosts } from "../utils/feed.ts";

const all = await getCollection("posts", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});
const posts = publishedPosts(all);
---

<BaseLayout title="Pullets Forever" description="A blog by dwk.">
  <div class="home-layout">
    <div class="home-feed">
      <ul class="post-list">
        {
          posts.map((post) => (
            <li class="h-entry">
              <a href={`/${post.id}/`} class="u-url">
                <h2 class="p-name">{post.data.title}</h2>
              </a>
              <time
                class="dt-published"
                datetime={post.data.publishDate.toISOString()}
              >
                {post.data.publishDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              <p class="p-summary">{post.data.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <Sidebar />
  </div>
</BaseLayout>
