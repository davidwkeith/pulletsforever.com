---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import { getCollection, render } from "astro:content";
import { publishedPosts, type Post } from "../utils/feed.ts";

export async function getStaticPaths() {
  const all = await getCollection("posts", ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });
  const ordered = publishedPosts(all);
  return ordered.map((post, idx) => ({
    params: { slug: post.id },
    props: {
      post,
      // newer first → "previous" (older) is at idx+1, "next" (newer) is at idx-1
      newer: idx > 0 ? ordered[idx - 1] : null,
      older: idx < ordered.length - 1 ? ordered[idx + 1] : null,
    },
  }));
}

const { post, newer, older } = Astro.props as {
  post: Post;
  newer: Post | null;
  older: Post | null;
};
const { Content } = await render(post);

// Build a canonical absolute URL for og:image / JSON-LD from the
// optimized hero. The Image component handles inline rendering;
// getImage() gives us the same hashed URL for use in metadata.
const heroOgImage = post.data.image
  ? (await getImage({ src: post.data.image, format: "webp", width: 1200 })).src
  : undefined;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  ...(heroOgImage && {
    image: new URL(heroOgImage, Astro.site).toString(),
  }),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={heroOgImage}
  jsonLd={articleJsonLd}
>
  <article class="h-entry">
    <h1 class="p-name">{post.data.title}</h1>
    <time
      class="dt-published"
      datetime={post.data.publishDate.toISOString()}
    >
      {post.data.publishDate.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })}
    </time>

    {
      post.data.image && (
        <Image
          src={post.data.image}
          alt={post.data.imageAlt || ""}
          class="u-photo"
          loading="eager"
          formats={["webp", "avif"]}
        />
      )
    }

    <div class="e-content">
      <Content />
    </div>

    {
      post.data.tags.length > 0 && (
        <ul class="tags">
          {post.data.tags.map((tag) => (
            <li class="p-category">{tag}</li>
          ))}
        </ul>
      )
    }

    {
      post.data.syndication.length > 0 && (
        <ul class="syndication">
          {post.data.syndication.map((url) => (
            <li>
              <a href={url} class="u-syndication" rel="syndication">
                {new URL(url).hostname}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </article>

  {(older || newer) && (
    <nav aria-label="Post navigation" class="links-nextprev">
      {older ? (
        <a href={`/${older.id}/`} rel="prev">← {older.data.title}</a>
      ) : (
        <span />
      )}
      {newer ? (
        <a href={`/${newer.id}/`} rel="next">{newer.data.title} →</a>
      ) : (
        <span />
      )}
    </nav>
  )}
</BaseLayout>
